generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                 String           @id @default(uuid()) @db.Uuid
  username           String           @unique @db.VarChar(100)
  fullName           String?          @db.VarChar(200)
  passwordHash       String
  phone              String?          @db.VarChar(30)
  role               Role
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(true)
  apartments         AdminApartment[]
  contactsCreated    ApartmentContact[]
  lineInvitesCreated LineLinkInvite[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("User_Admin")
}

model TenantUser {
  id                 String    @id @default(uuid()) @db.Uuid
  apartmentId        String    @db.Uuid
  apartment          Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  username           String    @unique @db.VarChar(100)
  fullName           String    @db.VarChar(200)
  roomNumber         String    @db.VarChar(20)
  floor              String?   @db.VarChar(20)
  idCard             String?   @db.VarChar(30)
  moveInDate         DateTime  @default(now())
  moveOutDate        DateTime?
  passwordHash       String
  phone              String?   @db.VarChar(30)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  bills              Bill[]
  lineAccount        TenantLineAccount?
  lineInvites        LineLinkInvite[]
  lineNotifications  LineNotification[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([apartmentId, roomNumber])
  @@unique([apartmentId, idCard])
  @@map("User_Tenant")
}

model AdminApartment {
  adminUserId   String    @db.Uuid
  apartmentId   String    @db.Uuid
  isPrimary     Boolean   @default(false)
  accessStartsAt DateTime @default(now())
  accessEndsAt   DateTime
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  apartment      Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())

  @@id([adminUserId, apartmentId])
  @@index([apartmentId])
}

model Apartment {
  id         String           @id @default(uuid()) @db.Uuid
  name       String           @db.VarChar(200)
  slug       String           @unique @db.VarChar(100)
  subdomain  String           @unique @db.VarChar(100)
  totalRooms Int              @default(0)
  isActive   Boolean          @default(true)
  adminUsers AdminApartment[]
  rooms      Room[]
  tenants    TenantUser[]
  billingItems ApartmentBillingItem[]
  bills      Bill[]
  contacts   ApartmentContact[]
  lineAccounts TenantLineAccount[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model AdminRegistration {
  id                 String             @id @default(uuid()) @db.Uuid
  plan               RegistrationPlan
  status             RegistrationStatus @default(PENDING)
  firstNameTh        String             @db.VarChar(100)
  lastNameTh         String             @db.VarChar(100)
  firstNameEn        String             @db.VarChar(100)
  lastNameEn         String             @db.VarChar(100)
  birthDate          DateTime
  phone              String             @db.VarChar(30)
  email              String             @db.VarChar(200)
  ownerFullNameTh    String             @db.VarChar(200)
  ownerFullNameEn    String             @db.VarChar(200)
  apartmentNameTh    String             @db.VarChar(200)
  apartmentNameEn    String             @db.VarChar(200)
  totalRooms         Int
  houseNumber        String             @db.VarChar(50)
  moo                String?            @db.VarChar(50)
  subdistrict        String             @db.VarChar(100)
  district           String             @db.VarChar(100)
  province           String             @db.VarChar(100)
  postalCode         String             @db.VarChar(10)
  approvedAdminId    String?            @db.Uuid
  approvedApartmentId String?           @db.Uuid
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model CustomPlanInquiry {
  id          String        @id @default(uuid()) @db.Uuid
  fullName    String        @db.VarChar(200)
  phone       String        @db.VarChar(30)
  email       String        @db.VarChar(200)
  lineId      String?       @db.VarChar(100)
  message     String        @db.VarChar(3000)
  status      InquiryStatus @default(NEW)
  contactedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Room {
  id            String    @id @default(uuid()) @db.Uuid
  apartmentId   String    @db.Uuid
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  roomNumber    String    @db.VarChar(20)
  floor         String?   @db.VarChar(20)
  isPlaceholder Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([apartmentId, roomNumber])
  @@index([apartmentId, isActive])
}

model ApartmentBillingItem {
  id              String             @id @default(uuid()) @db.Uuid
  apartmentId     String             @db.Uuid
  apartment       Apartment          @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  name            String             @db.VarChar(100)
  kind            BillingItemKind
  calculationType BillingCalculation
  unitPrice       Decimal            @db.Decimal(12, 2)
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([apartmentId, name])
  @@index([apartmentId, isActive, sortOrder])
}

model Bill {
  paymentSubmissions PaymentSubmission[]
  id            String      @id @default(uuid()) @db.Uuid
  apartmentId   String      @db.Uuid
  apartment     Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  tenantId      String?     @db.Uuid
  tenant        TenantUser? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantName    String      @db.VarChar(200)
  roomNumber    String      @db.VarChar(20)
  billingPeriod DateTime
  status        BillStatus  @default(SENT)
  totalAmount   Decimal     @db.Decimal(12, 2)
  issuedAt      DateTime    @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  items         BillItem[]
  lineNotifications LineNotification[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // A tenant may receive multiple bills in the same month (for example an
  // outstanding bill plus an additional charge or a corrected replacement).
  @@index([tenantId, billingPeriod])
  @@index([apartmentId, billingPeriod])
  @@index([apartmentId, status])
}

model ApartmentContact {
  id               String         @id @default(uuid()) @db.Uuid
  apartmentId      String         @db.Uuid
  apartment        Apartment      @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  createdByAdminId String         @db.Uuid
  createdByAdmin   AdminUser      @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  label            String         @db.VarChar(100)
  contactName      String?        @db.VarChar(150)
  channel          ContactChannel
  value            String         @db.VarChar(150)
  note             String?        @db.VarChar(500)
  isActive         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([apartmentId, isActive, sortOrder])
  @@index([createdByAdminId])
}

model LineOaConfig {
  id                              String   @id @default("central") @db.VarChar(30)
  oaBasicId                       String   @db.VarChar(100)
  messagingChannelId              String   @db.VarChar(100)
  messagingChannelSecretEncrypted String
  messagingAccessTokenEncrypted   String
  loginChannelId                  String   @db.VarChar(100)
  loginChannelSecretEncrypted     String
  apiBaseUrl                      String   @db.VarChar(500)
  frontendBaseUrl                 String   @db.VarChar(500)
  isActive                        Boolean  @default(true)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}

model TenantLineAccount {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @unique @db.Uuid
  tenant      TenantUser @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apartmentId String     @db.Uuid
  apartment   Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  lineUserId  String     @unique @db.VarChar(100)
  displayName String?    @db.VarChar(200)
  pictureUrl  String?    @db.VarChar(1000)
  isActive    Boolean    @default(true)
  linkedAt    DateTime   @default(now())
  unlinkedAt  DateTime?
  blockedAt   DateTime?
  updatedAt   DateTime   @updatedAt

  @@index([apartmentId, isActive])
}

model LineLinkInvite {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  tenant           TenantUser @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByAdminId String     @db.Uuid
  createdByAdmin   AdminUser  @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  tokenHash        String     @unique @db.VarChar(64)
  oauthStateHash   String?    @unique @db.VarChar(64)
  expiresAt        DateTime
  startedAt        DateTime?
  usedAt           DateTime?
  createdAt        DateTime   @default(now())

  @@index([tenantId, expiresAt])
  @@index([createdByAdminId])
}

model LineNotification {
  id           String                 @id @default(uuid()) @db.Uuid
  billId       String                 @db.Uuid
  bill         Bill                   @relation(fields: [billId], references: [id], onDelete: Cascade)
  tenantId     String?                @db.Uuid
  tenant       TenantUser?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  eventType    LineNotificationType
  status       LineNotificationStatus @default(PENDING)
  attemptCount Int                    @default(0)
  lastError    String?                @db.VarChar(1000)
  sentAt       DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([billId, eventType])
  @@index([status, createdAt])
  @@index([tenantId])
}

model BillItem {
  id              String             @id @default(uuid()) @db.Uuid
  billId          String             @db.Uuid
  bill            Bill               @relation(fields: [billId], references: [id], onDelete: Cascade)
  name            String             @db.VarChar(100)
  kind            BillingItemKind
  calculationType BillingCalculation
  quantity        Decimal            @db.Decimal(12, 3)
  unitPrice       Decimal            @db.Decimal(12, 2)
  amount          Decimal            @db.Decimal(12, 2)
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([billId, sortOrder])
}

enum Role {
  SUPER_ADMIN
  APARTMENT_ADMIN
  TENANT
}

enum BillingItemKind {
  RENT
  WATER
  ELECTRICITY
  OTHER
}

enum BillingCalculation {
  FIXED
  USAGE
}

enum BillStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum ContactChannel {
  PHONE
  LINE
}

enum LineNotificationType {
  BILL_CREATED
  BILL_OVERDUE
  BILL_PAID
}

enum LineNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum RegistrationPlan {
  FREE_30_DAYS
  TRIAL_3_MONTHS
  FULL_1_YEAR
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model PaymentSubmission {
  id String @id @default(uuid()) @db.Uuid
  billId String @db.Uuid
  bill Bill @relation(fields: [billId], references: [id], onDelete: Restrict)
  apartmentId String @db.Uuid
  tenantId String @db.Uuid
  roomId String? @db.Uuid
  roomNumber String @db.VarChar(20)
  tenantName String @db.VarChar(200)
  uploadKey String @unique
  objectKey String? @unique
  mimeType String
  sizeBytes Int
  transferredAt DateTime
  status PaymentSubmissionStatus @default(UPLOADING)
  createdAt DateTime @default(now())
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedById String? @db.Uuid
  rejectionNote String? @db.VarChar(500)

  @@index([apartmentId, roomNumber, createdAt])
  @@index([apartmentId, roomId, createdAt])
  @@index([tenantId, createdAt])
}

enum PaymentSubmissionStatus {
  UPLOADING
  PENDING
  APPROVED
  REJECTED
}
