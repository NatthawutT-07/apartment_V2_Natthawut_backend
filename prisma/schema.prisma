generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                 String           @id @default(uuid()) @db.Uuid
  username           String           @unique @db.VarChar(100)
  fullName           String?          @db.VarChar(200)
  passwordHash       String
  phone              String?          @db.VarChar(30)
  role               Role
  isActive           Boolean          @default(true)
  mustChangePassword Boolean          @default(true)
  apartments         AdminApartment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("User_Admin")
}

model TenantUser {
  id                 String    @id @default(uuid()) @db.Uuid
  apartmentId        String    @db.Uuid
  apartment          Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  username           String    @db.VarChar(100)
  fullName           String    @db.VarChar(200)
  roomNumber         String    @db.VarChar(20)
  passwordHash       String
  phone              String?   @db.VarChar(30)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([apartmentId, username])
  @@unique([apartmentId, roomNumber])
  @@index([username])
  @@map("User_Tenant")
}

model AdminApartment {
  adminUserId   String    @db.Uuid
  apartmentId   String    @db.Uuid
  isPrimary     Boolean   @default(false)
  accessStartsAt DateTime @default(now())
  accessEndsAt   DateTime
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  apartment      Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())

  @@id([adminUserId, apartmentId])
  @@index([apartmentId])
}

model Apartment {
  id         String           @id @default(uuid()) @db.Uuid
  name       String           @db.VarChar(200)
  slug       String           @unique @db.VarChar(100)
  subdomain  String           @unique @db.VarChar(100)
  totalRooms Int              @default(0)
  isActive   Boolean          @default(true)
  adminUsers AdminApartment[]
  rooms      Room[]
  tenants    TenantUser[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model Room {
  id            String    @id @default(uuid()) @db.Uuid
  apartmentId   String    @db.Uuid
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  roomNumber    String    @db.VarChar(20)
  isPlaceholder Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([apartmentId, roomNumber])
  @@index([apartmentId, isActive])
}

enum Role {
  SUPER_ADMIN
  APARTMENT_ADMIN
  TENANT
}
