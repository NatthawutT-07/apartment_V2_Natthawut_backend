DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apartment"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
PORT=3000

# Private payment slip storage (server only; never use VITE_ prefixes).
R2_ACCOUNT_ID="250733967de686c13218ee4819c47aa4"
R2_BUCKET="apartment-images"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Exactly 32 random bytes encoded as base64. Used only to encrypt LINE secrets at rest.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
LINE_CONFIG_ENCRYPTION_KEY="replace-with-base64-key"

# Central LINE OA. Set LINE_CONFIG_SOURCE=env to manage LINE entirely from this file.
LINE_CONFIG_SOURCE="env"
LINE_OA_ACTIVE=false
LINE_OA_BASIC_ID="@your-basic-id"
LINE_MESSAGING_CHANNEL_ID=""
LINE_MESSAGING_CHANNEL_SECRET=""
LINE_MESSAGING_ACCESS_TOKEN=""
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
LINE_PUBLIC_API_BASE_URL="https://your-api-or-tunnel.example.com"
LINE_FRONTEND_BASE_URL="http://localhost:5173"

SUPER_ADMIN_PASSWORD="replace-before-seeding"
SEED_DEVELOPMENT_ACCOUNTS=false
APARTMENT_ADMIN_PASSWORD="replace-before-seeding"
TENANT_PASSWORD="replace-before-seeding"
SEED_USERS_MUST_CHANGE_PASSWORD=true
